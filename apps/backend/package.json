{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for CS stats",
  "main": "dist/server.js",
  "scripts": {
    "test": "jest --coverage --runInBand --ci --",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/server.js",
    "dev": "nodemon",
    "lint": "eslint .",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:down": "knex migrate:down",
    "migrate:up": "knex migrate:up",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run --specific=dev_seed.ts ",
    "reseed": "knex seed:run --specific=reset_seed.ts && knex seed:run",
    "seed:e2e": "knex seed:run --specific=e2e_test_seed.ts",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "node.js",
    "express.api",
    "typescript"
  ],
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-jwt": "8.5.1",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "jsonwebtoken": "9.0.2",
    "knex": "3.1.0",
    "lodash": "4.17.21",
    "morgan": "1.10.0",
    "ms": "2.1.3",
    "mysql2": "3.14.1",
    "nodemailer": "7.0.3",
    "passport": "0.7.0",
    "passport-steam": "1.0.18",
    "uuid": "11.1.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.59.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.201.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-node": "0.201.0",
    "@opentelemetry/semantic-conventions": "1.33.0",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.18",
    "@types/express": "5.0.2",
    "@types/ioredis-mock": "8.2.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.9",
    "@types/lodash": "4.17.16",
    "@types/morgan": "1.9.9",
    "@types/ms": "2.1.0",
    "@types/mysql": "2.15.27",
    "@types/node": "22.15.18",
    "@types/nodemailer": "6.4.17",
    "@types/passport": "1.0.17",
    "@types/passport-steam": "1.0.6",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "ioredis-mock": "8.9.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "nodemon": "3.1.10",
    "supertest": "7.1.1",
    "ts-jest": "29.3.4",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
