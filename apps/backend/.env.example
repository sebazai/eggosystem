# =============================================================================
# apps/backend environment variables
# =============================================================================
# Copy to `.env` and fill in the values you need:
#     cp apps/backend/.env.example apps/backend/.env
#
# Most variables have sensible defaults for local Docker/DevContainer dev
# (shown as "default: ..." below), so a minimal local setup only needs
# STEAM_API_KEY. Secrets must NEVER be committed — `.env` is gitignored.
# Non-secret, environment-specific values live in `.env.development` and
# `.env.local.test`.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# development | production | e2e (default: production)
NODE_ENV=development
# Public URLs used for CORS, OpenID return URLs and email links.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# Path prefix the API is mounted under when behind a reverse proxy (optional).
BASE_PATH=
# Version string users must accept; required by the privacy-policy flow.
PRIVACY_POLICY_VERSION=1

# --- Database (MariaDB) -------------------------------------------------------
DB_HOST=eggo-devdb          # default: eggo-devdb
DB_PORT=3306                # default: 3306
DB_USER=kanadbuser          # default: kanadbuser
DB_PASSWORD=dev-pass        # default: dev-pass
DB_NAME=kanaliiga           # default: kanaliiga
DB_CONNECTION_LIMIT=100     # pool size, default: 100

# --- Redis (queues / caching) -------------------------------------------------
REDIS_HOST=eggo-redis       # default: eggo-redis
REDIS_PORT=6379             # default: 6379

# --- RabbitMQ (demo parse queues) ---------------------------------------------
RABBITMQ_HOST=eggo-rabbitmq # default: eggo-rabbitmq
RABBITMQ_PORT=5672          # default: 5672
RABBITMQ_USER=test          # default: test
RABBITMQ_PASSWORD=test      # default: test
RABBITMQ_VHOST=/            # default: / (URL-encoded as %2F where needed)

# --- Authentication -----------------------------------------------------------
# Steam Web API key — required for Steam OpenID login.
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Symmetric secret used by auth flows (keep secret).
JWT_SECRET=
# Token lifetimes in seconds (defaults: access 20m = 1200, refresh 7d = 604800).
# NOTE: the RSA keypairs themselves are read from PEM files in this directory
# (private_access_token.pem, public_access_token.pem, and the refresh pair) —
# see the README "JWT Key Generation" section.
JWT_EXPIRES_IN=1200
JWT_REFRESH_EXPIRES_IN=604800
# Shared key for internal/service-to-service requests.
BACKEND_SERVICE_API_KEY=

# --- FACEIT integration -------------------------------------------------------
# Optional — most flows work without it. https://developers.faceit.com/
FACEIT_API_KEY=
# Validates incoming FACEIT webhooks.
FACEIT_WEBHOOK_API_KEY=

# --- Discord integration ------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_KANABOT_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_GENERAL_CHANNEL_ID=

# --- PUBG integration --------------------------------------------------------
# PUBG API key for ingesting PUBG matches. Get one at https://developer.pubg.com/
# API reference: https://documentation.pubg.com/
PUBG_API_KEY=

# --- Allstar integration ------------------------------------------------------
ALLSTAR_API_KEY=
# Validates incoming Allstar webhooks.
ALLSTAR_WEBHOOK_TOKEN=

# --- Image service ------------------------------------------------------------
IMAGE_SERVICE_URL=https://img.kanaliiga.fi      # default: https://img.kanaliiga.fi
IMAGE_SERVICE_BASE_URL=https://img.kanaliiga.fi # default: https://img.kanaliiga.fi
IMAGE_SERVICE_API_KEY=

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Delay between newsletter sends in ms (default: 750).
EMAIL_SEND_DELAY_MS=750

# --- External services --------------------------------------------------------
# CSRankker backend base URL.
CSRANKKER_BACKEND_API=

# --- Observability / profiling (OpenTelemetry) --------------------------------
# Set ENABLE_PROFILING=true to enable Pyroscope/OTEL profiling (off in prod by default).
ENABLE_PROFILING=false
OTEL_SERVICE_NAME=eggosystem-backend-1   # default: eggosystem-backend-1
OTEL_SERVICE_NAMESPACE=eggosystem        # default: eggosystem
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROFILING_ENDPOINT=
OTEL_EXPORTER_OTLP_PROFILING_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_PROFILING_REGION_TAG=
OTEL_EXPORTER_OTLP_PROFILING_VERSION_TAG=
