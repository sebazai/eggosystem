{
  "name": "@eggosystem/viewer",
  "version": "1.0.0",
  "description": "CS2 2D Demo Viewer component for Eggosystem",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "node dev-server.js",
    "dev:direct": "vite",
    "dev:build": "tsc --watch",
    "clean": "rm -rf cache dist .tsbuildinfo"
  },
  "keywords": [
    "cs2",
    "demo",
    "viewer",
    "react",
    "component"
  ],
  "author": "Sebastian Sergelius",
  "license": "GPL-3.0",
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eggosystem/tsconfig": "workspace:*",
    "@eggosystem/eslint": "workspace:*",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "dotenv": "17.4.2",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  },
  "peerDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/components/Viewer.css"
  }
}
