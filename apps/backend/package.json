{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for CS stats",
  "main": "dist/server.js",
  "scripts": {
    "pretest": "pnpm --filter=@eggosystem/shared-msw build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/server.js",
    "dev": "nodemon",
    "dev:e2e": "TEST_TYPE=e2e nodemon",
    "test": "NODE_ENV=test jest --coverage --runInBand --ci --detectOpenHandles --",
    "test:watch": "NODE_ENV=test jest --coverage --runInBand --ci --detectOpenHandles --watch",
    "test:debug": "NODE_ENV=test node --inspect-brk node_modules/.bin/jest --runInBand --no-cache",
    "lint": "eslint .",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:down": "knex migrate:down",
    "migrate:up": "knex migrate:up",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run --specific=dev_seed.ts ",
    "reseed": "knex seed:run --specific=reset_seed.ts && pnpm seed && pnpm migrate",
    "reseed:e2e": "knex seed:run --specific=reset_seed.ts && pnpm seed && pnpm migrate && pnpm seed:e2e",
    "seed:e2e": "knex seed:run --specific=e2e_test_seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf cache dist"
  },
  "keywords": [
    "node.js",
    "express.api",
    "typescript"
  ],
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.62.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.203.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-logs": "0.203.0",
    "@opentelemetry/sdk-node": "0.203.0",
    "@opentelemetry/semantic-conventions": "1.36.0",
    "@pyroscope/nodejs": "^0.4.5",
    "amqplib": "0.10.8",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "discord.js": "14.21.0",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "express-jwt": "8.5.1",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "json-bigint": "1.0.0",
    "jsonwebtoken": "9.0.2",
    "knex": "3.1.0",
    "lodash": "4.17.21",
    "moment-timezone": "0.6.0",
    "morgan": "1.10.1",
    "ms": "2.1.3",
    "mysql2": "3.14.3",
    "node-cron": "4.2.1",
    "nodemailer": "7.0.5",
    "passport": "0.7.0",
    "passport-steam": "1.0.18",
    "uuid": "11.1.0",
    "winston": "3.17.0",
    "winston-transport": "4.9.0",
    "zod": "4.1.3"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-env": "7.28.0",
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/shared-msw": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@types/amqplib": "0.10.7",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/ioredis-mock": "8.2.6",
    "@types/jest": "30.0.0",
    "@types/json-bigint": "1.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.20",
    "@types/morgan": "1.9.10",
    "@types/ms": "2.1.0",
    "@types/mysql": "2.15.27",
    "@types/node": "22.15.18",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "6.4.17",
    "@types/passport": "1.0.17",
    "@types/passport-steam": "1.0.6",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "babel-jest": "30.0.5",
    "eslint": "9.34.0",
    "ioredis-mock": "8.9.0",
    "jest": "30.0.5",
    "jest-junit": "16.0.0",
    "nodemon": "3.1.10",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  }
}
