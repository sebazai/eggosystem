{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh enforce-rtk-shell.sh",
        "matcher": "\\b(git|gh|pnpm|docker|kubectl|docker-compose)\\b",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh block-e2e-wrong-dir.sh",
        "matcher": "Shell",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh enforce-typecheck-command.sh",
        "matcher": "Shell",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh warn-directory-execution.sh",
        "matcher": "Shell",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh validate-envelope.sh",
        "matcher": "Task",
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh warn-as-cast.sh",
        "matcher": "Write",
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh warn-try-without-finally.sh",
        "matcher": "Write",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh format-edited-file.sh",
        "matcher": "Write",
        "timeout": 120
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/audit-subagent-start.sh",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/audit-subagent-stop.sh",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/run-claude-project-hook.sh remind-quality-gates.sh",
        "timeout": 10
      }
    ]
  }
}
