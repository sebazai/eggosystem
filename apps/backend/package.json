{
  "name": "kanastats-backend",
  "version": "1.0.0",
  "description": "Backend for CS stats",
  "main": "build/app.js",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "scripts": {
    "test": "jest --coverage --runInBand",
    "build": "tsc -p .",
    "start": "node .",
    "dev": "nodemon server.ts",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:down": "knex migrate:down",
    "prepare": "husky install"
  },
  "keywords": [
    "node.js",
    "express.api",
    "typescript"
  ],
  "author": "jari.haikonen@gmail.com",
  "license": "ISC",
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-async-errors": "3.1.1",
    "helmet": "8.0.0",
    "knex": "3.1.0",
    "morgan": "1.10.0",
    "mysql2": "3.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/cors": "2.8.17",
    "@types/dotenv": "8.2.0",
    "@types/express": "5.0.0",
    "@types/helmet": "4.0.0",
    "@types/jest": "29.5.14",
    "@types/morgan": "1.9.9",
    "@types/mysql": "2.15.26",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.23.0",
    "@typescript-eslint/parser": "8.23.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-jest": "28.11.0",
    "eslint-plugin-prettier": "5.2.3",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "lint-staged": "15.4.3",
    "node-ts": "6.1.3",
    "nodemon": "3.1.9",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
