{
  "extends": "@eggosystem/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "@eggosystem/types": ["../../packages/types/dist/index"],
      "@eggosystem/viewer": ["../../packages/viewer/src/index"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "eslint.config.mjs",
    "types/**.d.ts"
  ],
  "types": ["jest", "@testing-library/jest-dom"],
  "exclude": ["node_modules", ".next"]
}
