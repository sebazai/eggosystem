{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "pnpm copy-standalone",
    "copy-standalone": "mkdir -p .next/standalone/apps/frontend/.next/static && cp -r .next/static/* .next/standalone/apps/frontend/.next/static/ && cp -r public .next/standalone/apps/frontend/public",
    "start:standalone": "PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/apps/frontend/server.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "PW_TEST_HTML_REPORT_OPEN='never' TEST_TYPE=e2e playwright test",
    "test:e2e:ui": "TEST_TYPE=e2e playwright test --ui",
    "test:e2e:headed": "TEST_TYPE=e2e playwright test --headed",
    "test:e2e:container": "TEST_TYPE=e2e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright playwright test",
    "clean": "rm -rf cache .next"
  },
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/list": "6.1.19",
    "@fullcalendar/react": "6.1.19",
    "@fullcalendar/timegrid": "6.1.19",
    "@hookform/error-message": "2.0.1",
    "@hookform/resolvers": "5.2.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "framer-motion": "12.23.12",
    "js-cookie": "3.0.5",
    "lodash": "4.17.21",
    "lucide-react": "0.536.0",
    "next": "15.4.5",
    "next-themes": "0.4.6",
    "react": "19.1.1",
    "react-day-picker": "9.8.0",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "recharts": "2.15.3",
    "sonner": "2.0.7",
    "swr": "2.3.4",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.3"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/js-cookie": "3.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.20",
    "@types/node": "22.15.18",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "jest": "30.0.5",
    "jest-environment-jsdom": "30.0.5",
    "jest-junit": "16.0.0",
    "jsdom": "26.1.0",
    "jsonwebtoken": "9.0.2",
    "shadcn": "2.10.0",
    "tailwindcss": "4.1.11",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.2",
    "uuid": "11.1.0"
  }
}
