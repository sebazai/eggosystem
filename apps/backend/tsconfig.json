{
  "extends": "@eggosystem/tsconfig/express.json",
  "compilerOptions": {
    "typeRoots": ["node_modules/@types", "./node_modules/@types", "src/types"],
    "types": ["jest", "node"],
    "rootDir": ".",
    "outDir": "dist",
    "isolatedModules": true,
    "paths": {
      "@eggosystem/types": ["../../packages/types/dist/index"],
      "@eggosystem/shared-msw": ["../../packages/shared-msw/dist/index"]
    }
  },
  "include": [
    "src/**/*.ts",
    "eslint.config.mjs",
    "server.ts",
    "migrations/**/*.ts",
    "seeds/**/*.ts",
    "knexfile.ts",
    "jest.setup.ts",
    "src/**/*.d.ts"
  ]
}
