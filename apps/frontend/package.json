{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "pnpm copy-standalone",
    "copy-standalone": "mkdir -p .next/standalone/apps/frontend/.next/static && cp -r .next/static/* .next/standalone/apps/frontend/.next/static/ && cp -r public .next/standalone/apps/frontend/public",
    "start:standalone": "PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/apps/frontend/server.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --",
    "test:watch": "jest --watch",
    "test:e2e": "PW_TEST_HTML_REPORT_OPEN='never' TEST_TYPE=e2e playwright test",
    "test:e2e:ui": "TEST_TYPE=e2e playwright test --ui",
    "test:e2e:headed": "TEST_TYPE=e2e playwright test --headed",
    "test:e2e:container": "TEST_TYPE=e2e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright playwright test"
  },
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "@hookform/error-message": "2.0.1",
    "@hookform/resolvers": "5.0.1",
    "@radix-ui/react-accordion": "1.2.4",
    "@radix-ui/react-checkbox": "1.1.5",
    "@radix-ui/react-dialog": "1.1.7",
    "@radix-ui/react-dropdown-menu": "2.1.7",
    "@radix-ui/react-label": "2.1.3",
    "@radix-ui/react-navigation-menu": "1.2.6",
    "@radix-ui/react-popover": "1.1.7",
    "@radix-ui/react-select": "2.2.4",
    "@radix-ui/react-separator": "1.1.4",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-tabs": "1.1.4",
    "@radix-ui/react-tooltip": "1.2.0",
    "@tailwindcss/postcss": "4.1.7",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.12.1",
    "js-cookie": "3.0.5",
    "lodash": "4.17.21",
    "lucide-react": "0.511.0",
    "next": "15.3.1",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.56.4",
    "recharts": "2.15.3",
    "sonner": "2.0.3",
    "swr": "2.3.3",
    "tailwind-merge": "3.3.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@playwright/test": "1.53.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/js-cookie": "3.0.6",
    "@types/jsonwebtoken": "9.0.9",
    "@types/lodash": "4.17.16",
    "@types/node": "22.15.18",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "jest": "30.0.4",
    "jest-environment-jsdom": "30.0.4",
    "jest-junit": "16.0.0",
    "jsdom": "26.1.0",
    "jsonwebtoken": "9.0.2",
    "shadcn": "2.5.0",
    "tailwindcss": "4.1.7",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.3",
    "uuid": "11.1.0"
  }
}
