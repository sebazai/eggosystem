{
  "name": "eggosystem",
  "version": "1.0.0",
  "author": "Sebastian Sergelius",
  "license": "GPL-3.0",
  "description": "A unified monorepo for Kanahub's frontend and backend services.",
  "scripts": {
    "shadcn:add": "turbo run shadcn:add -- --",
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "test": "turbo test",
    "install:playwright": "pnpm exec playwright install chromium && pnpm exec playwright install-deps chromium",
    "test:watch": "pnpm --filter=frontend test:watch & pnpm --filter=backend test:watch",
    "test:e2e": "pnpm build && pnpm --filter=backend reseed:e2e && pnpm --filter=frontend test:e2e --",
    "test:e2e:run": "pnpm --filter=frontend test:e2e --",
    "test:e2e:clean": "pnpm clean && rm -rf apps/frontend/.next apps/frontend/playwright-report apps/frontend/test-results .turbo apps/*/.turbo && pnpm test:e2e",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:e2e:ui": "pnpm --filter=frontend test:e2e:ui",
    "test:e2e:ui:container": "xvfb-run -a pnpm --filter=frontend test:e2e:ui",
    "playwright-trace": "pnpm --filter=frontend playwright-trace --",
    "test:backend": "pnpm --filter=backend test",
    "lint": "turbo lint --continue",
    "lint:fix": "turbo lint --continue -- --fix",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "knip": "NODE_OPTIONS=\"--experimental-require-module\" knip",
    "format": "prettier --write \"**/*.{ts,tsx,md,mjs,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mjs,js,jsx,json}\"",
    "prepare": "[ \"$NODE_ENV\" != \"production\" ] && husky || true",
    "migrate": "turbo migrate",
    "migrate:rollback": "turbo migrate:rollback",
    "migrate:down": "turbo migrate:down",
    "migrate:up": "turbo migrate:up",
    "migrate:make": "turbo migrate:make --",
    "migrate:status": "turbo migrate:status",
    "seed": "turbo seed --",
    "seed:reset": "pnpm reseed",
    "reseed": "pnpm --filter=backend reseed",
    "worktree:ensure": "node ./scripts/ensure-worktree-pnpm.mjs",
    "quality": "pnpm knip && pnpm typecheck && pnpm format:check && pnpm lint",
    "fresh": "pnpm clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.turbo packages/*/.turbo .turbo && pnpm install && pnpm build && pnpm reseed",
    "setup:dev": "pnpm install && pnpm install:playwright && pnpm build && pnpm migrate && pnpm seed",
    "gitlab:mcp:pat": "bash scripts/gitlab-mcp-pat-setup.sh"
  },
  "keywords": [
    "kanahub",
    "eggosystem"
  ],
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.72.0",
    "turbo": "2.9.5"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@playwright/test": "1.59.1",
    "@types/node": "25.5.2",
    "eslint": "10.2.0",
    "husky": "9.1.7",
    "knip": "6.6.1",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "form-data@>=4.0.0 <4.0.4": ">=4.0.4",
      "axios@>=1.0.0 <1.12.0": ">=1.12.0",
      "axios@<1.13.5": ">=1.13.5",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "@modelcontextprotocol/sdk@<1.25.2": ">=1.25.2",
      "jws@<3.2.3": ">=3.2.3",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "qs@<6.14.2": ">=6.14.2",
      "hono@<4.12.4": ">=4.12.4",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "express-rate-limit@<8.2.2": ">=8.2.2",
      "flatted@<3.4.2": ">=3.4.2",
      "undici@<6.23.0": ">=6.23.0",
      "undici@<7.24.0": ">=7.24.0",
      "js-yaml@<3.14.2": ">=3.14.2",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "minimatch@<9.0.0": ">=9.0.5",
      "minimatch@<10.2.3": ">=10.2.3",
      "diff@<8.0.3": ">=8.0.3",
      "fastify@<=5.7.2": ">=5.7.3",
      "fastify@<5.8.5": ">=5.8.5",
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "readdirp>picomatch": ">=4.0.4",
      "ajv@>=8.0.0 <8.18.0": ">=8.18.0",
      "smol-toml@<1.6.1": ">=1.6.1",
      "protobufjs@<7.5.5": ">=7.5.5",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    }
  }
}
