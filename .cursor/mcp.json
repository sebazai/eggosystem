{
  "mcpServers": {
    "mariadb": {
      "command": "uv",
      "args": ["--directory", "/workspace/mariadb-mcp", "run", "src/server.py"],
      "env": {
        "DB_HOST": "eggo-devdb",
        "DB_PORT": "3306",
        "DB_USER": "mcp_readonly",
        "DB_PASSWORD": "dev-pass",
        "DB_NAME": "kanaliiga",
        "MCP_READ_ONLY": "true"
      }
    },
    "Playwright": {
      "command": "npx -y @playwright/mcp@latest",
      "env": {},
      "args": []
    },
    "shadcn/ui": {
      "command": "pnpm",
      "args": ["-C", "/workspace/apps/frontend", "exec", "shadcn", "mcp"],
      "env": {}
    }
  }
}
