{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["!**"],
      "project": ["!**"],
      "jest": false,
      "playwright": false,
      "next": false
    },
    "apps/backend": {
      "entry": ["server.ts", "migrations/**/*.ts", "seeds/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/frontend": {
      "entry": ["src/app/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "jest.config.js"],
      "jest": false,
      "ignoreDependencies": [
        "tailwindcss",
        "tailwindcss-animate",
        "jest-environment-jsdom"
      ]
    },
    "packages/eslint": {
      "entry": ["*.js"],
      "project": ["*.js"]
    },
    "packages/shared-msw": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/tsconfig": {
      "entry": ["!**"],
      "project": ["!**"]
    },
    "packages/types": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/viewer": {
      "entry": ["dev/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/test-utils/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/apps/frontend/src/components/ui/**",
    "**/apps/frontend/jest.config.js"
  ]
}
