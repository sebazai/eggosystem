{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "env": [
        "DB_ROOT_USER",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "PORT",
        "DB_HOST",
        "DB_PORT",
        "STEAM_API_KEY",
        "FACEIT_API_KEY",
        "JWT_EXPIRES_IN",
        "JWT_REFRESH_EXPIRES_IN",
        "REDIS_HOST",
        "REDIS_PORT",
        "FRONTEND_URL",
        "BACKEND_URL",
        "BASE_PATH",
        "PRIVACY_POLICY_VERSION",
        "SMTP_HOST",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "ALLSTAR_WEBHOOK_TOKEN",
        "ALLSTAR_API_KEY"
      ],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "dist/**/*.d.ts"]
    },
    "@eggosystem/types#build": {
      "outputs": [
        "dist/**",
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "node_modules/**"
      ]
    },
    "backend#build": {
      "dependsOn": ["@eggosystem/types#build"],
      "outputs": ["dist/**", "node_modules/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "@eggosystem/types#build"]
    },
    "dev": {
      "dependsOn": ["@eggosystem/types#build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["@eggosystem/types#build"]
    },
    "test:integration": {
      "dependsOn": ["@eggosystem/types#build"]
    },
    "shadcn:add": {
      "cache": false
    },
    "migrate": {
      "env": ["NODE_ENV", "DB_HOST", "DB_USER", "DB_PASSWORD", "DB_NAME"],
      "cache": false
    },
    "migrate:rollback": { "cache": false },
    "migrate:down": { "cache": false },
    "migrate:up": { "cache": false },
    "migrate:make": { "cache": false },
    "seed": {
      "env": ["NODE_ENV", "DB_HOST", "DB_USER", "DB_PASSWORD", "DB_NAME"],
      "cache": false
    }
  }
}
