{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for CS stats",
  "main": "dist/server.js",
  "scripts": {
    "test": "jest --coverage --runInBand --ci",
    "build": "tsc -p tsconfig.prod.json",
    "start": "node ./dist/server.js",
    "dev": "NODE_ENV=development nodemon server.ts",
    "lint": "eslint .",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:down": "knex migrate:down",
    "migrate:up": "knex migrate:up",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "node.js",
    "express.api",
    "typescript"
  ],
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-async-errors": "3.1.1",
    "express-jwt": "8.5.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "knex": "3.1.0",
    "morgan": "1.10.0",
    "mysql2": "3.13.0",
    "passport": "0.7.0",
    "passport-steam": "1.0.18",
    "redis": "4.7.0"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@eslint/js": "9.22.0",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.9",
    "@types/morgan": "1.9.9",
    "@types/mysql": "2.15.26",
    "@types/node": "22.13.10",
    "@types/passport": "1.0.17",
    "@types/passport-steam": "1.0.6",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "eslint": "9.22.0",
    "eslint-plugin-jest": "28.11.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "nodemon": "3.1.9",
    "supertest": "7.0.0",
    "ts-jest": "29.2.6",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  }
}
