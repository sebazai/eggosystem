{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "add-shadcn-component": "pnpm dlx shadcn@canary add",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "test": "playwright test src/__tests__/integration/ --reporter=dot",
    "test:integration": "pnpm --filter=\"@eggosystem/types\" build && playwright test src/__tests__/integration/",
    "test:integration:profile": "pnpm --filter=\"@eggosystem/types\" build && playwright test src/__tests__/integration/profile-form.spec.ts",
    "test:integration:ui": "playwright test src/__tests__/integration/ --ui",
    "test:integration:headed": "playwright test src/__tests__/integration/ --headed",
    "test:e2e": "pnpm --filter=\"@eggosystem/types\" build && playwright test src/__tests__/e2e/",
    "test:e2e:ui": "playwright test src/__tests__/e2e/ --ui",
    "test:e2e:headed": "playwright test src/__tests__/e2e/ --headed",
    "test:e2e:profile": "pnpm --filter=\"@eggosystem/types\" build && playwright test src/__tests__/e2e/profile-form.spec.ts",
    "test:e2e:container": "PLAYWRIGHT_BROWSERS_PATH=/ms-playwright playwright test src/__tests__/e2e/ --browser=chromium"
  },
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "@hookform/error-message": "2.0.1",
    "@hookform/resolvers": "4.1.3",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tailwindcss/postcss": "4.0.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "framer-motion": "12.4.10",
    "js-cookie": "3.0.5",
    "lodash": "4.17.21",
    "lucide-react": "0.479.0",
    "next": "15.2.1",
    "next-themes": "0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.54.2",
    "swr": "2.3.3",
    "tailwind-merge": "3.0.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@playwright/test": "1.51.1",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.16",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "shadcn": "2.3.0",
    "tailwindcss": "4.0.12",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.2"
  }
}
