# Copy to .env.mcp and fill in (do not commit .env.mcp).
# GitLab MCP loads this file via .cursor/gitlab-mcp.sh (see .cursor/mcp.json).
#
#   pnpm gitlab:mcp:pat
#   # or: cp .env.mcp.example .env.mcp
#
# Create a Personal Access Token: GitLab → Preferences → Access Tokens.
# Scopes: use `read_api` for read-only, or `api` if the MCP tools should write.
# https://docs.gitlab.com/ee/user/profile/personal_access_tokens.html

GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

# Optional
# GITLAB_READ_ONLY_MODE=true
# LOG_LEVEL=debug
