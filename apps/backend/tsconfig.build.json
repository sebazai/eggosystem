{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "types": ["node"],
    "customConditions": []
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "src/__tests__",
    "src/__mocks__",
    "scripts/**",
    "jest.setup.ts"
  ]
}
