{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for CS stats",
  "main": "dist/server.js",
  "scripts": {
    "pretest": "pnpm --filter=@eggosystem/shared-msw build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/server.js",
    "dev": "nodemon",
    "dev:e2e": "NODE_ENV=e2e nodemon",
    "test": "NODE_ENV=test jest --coverage --",
    "test:watch": "NODE_ENV=test jest --coverage --runInBand --ci --detectOpenHandles --watch",
    "test:serial": "NODE_ENV=test jest --coverage --runInBand --ci --detectOpenHandles --",
    "test:debug": "NODE_ENV=test node --inspect-brk node_modules/.bin/jest --runInBand --no-cache",
    "lint": "eslint .",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:down": "knex migrate:down",
    "migrate:up": "knex migrate:up",
    "migrate:make": "knex migrate:make",
    "migrate:status": "knex migrate:status",
    "seed": "knex seed:run --specific=dev_seed.ts ",
    "reseed": "knex seed:run --specific=reset_seed.ts && pnpm seed && pnpm migrate",
    "reseed:e2e": "knex seed:run --specific=reset_seed.ts && pnpm seed && pnpm migrate && pnpm seed:e2e",
    "seed:e2e": "knex seed:run --specific=e2e_test_seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf cache dist",
    "test:email-queue": "ts-node scripts/test-email-queue.ts"
  },
  "keywords": [
    "node.js",
    "express.api",
    "typescript"
  ],
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.76.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.218.0",
    "@opentelemetry/otlp-exporter-base": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@pyroscope/nodejs": "0.4.11",
    "amqplib": "2.0.1",
    "bullmq": "5.76.8",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "discord.js": "14.26.4",
    "express": "5.2.1",
    "express-jwt": "8.5.1",
    "file-type": "22.0.1",
    "form-data": "4.0.5",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "json-bigint": "1.0.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.2.10",
    "lodash": "4.18.1",
    "moment-timezone": "0.6.2",
    "morgan": "1.10.1",
    "mysql2": "3.22.3",
    "node-cron": "4.2.1",
    "nodemailer": "8.0.7",
    "passport": "0.7.0",
    "passport-steam": "1.0.18",
    "semver": "7.8.0",
    "uuid": "11.1.0",
    "winston": "3.19.0",
    "winston-transport": "4.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.5",
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/shared-msw": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@types/amqplib": "0.10.8",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/json-bigint": "1.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.24",
    "@types/morgan": "1.9.10",
    "@types/node": "25.7.0",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "8.0.0",
    "@types/passport": "1.0.17",
    "@types/passport-steam": "1.0.6",
    "@types/semver": "7.7.1",
    "@types/supertest": "7.2.0",
    "babel-jest": "30.4.1",
    "dotenv": "17.4.2",
    "eslint": "10.3.0",
    "fastify": "5.8.5",
    "jest": "30.4.2",
    "jest-junit": "17.0.0",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
