{
  "name": "eggosystem",
  "version": "1.0.0",
  "author": "Sebastian Sergelius",
  "license": "GPL-3.0",
  "description": "A unified monorepo for Kanahub's frontend and backend services.",
  "scripts": {
    "shadcn:add": "turbo run shadcn:add -- --",
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "test": "turbo test",
    "install:playwright": "pnpm exec playwright install && pnpm exec playwright install-deps",
    "test:watch": "pnpm --filter=frontend test:watch & pnpm --filter=backend test:watch",
    "test:e2e": "pnpm --filter=backend reseed:e2e && pnpm build && pnpm --filter=frontend test:e2e --",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:e2e:ui": "pnpm --filter=frontend test:e2e:ui",
    "playwright-trace": "pnpm --filter=frontend playwright-trace --",
    "test:backend": "pnpm --filter=backend test",
    "lint": "turbo lint --continue",
    "lint:fix": "turbo lint --continue -- --fix",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,md,mjs,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mjs,js,jsx,json}\"",
    "prepare": "[ \"$NODE_ENV\" != \"production\" ] && husky || true",
    "migrate": "turbo migrate",
    "migrate:rollback": "turbo migrate:rollback",
    "migrate:down": "turbo migrate:down",
    "migrate:up": "turbo migrate:up",
    "migrate:make": "turbo migrate:make --",
    "migrate:status": "turbo migrate:status",
    "seed": "turbo seed --",
    "seed:reset": "pnpm reseed",
    "reseed": "pnpm --filter=backend reseed",
    "quality": "pnpm knip && pnpm typecheck && pnpm format:check && pnpm lint",
    "fresh": "pnpm clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.turbo packages/*/.turbo .turbo .pnpm-store && pnpm install && pnpm build && pnpm reseed",
    "setup:dev": "pnpm install && pnpm install:playwright && pnpm build && pnpm migrate && pnpm seed"
  },
  "keywords": [
    "kanahub",
    "eggosystem"
  ],
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.68.0",
    "turbo": "2.7.5"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@playwright/test": "1.57.0",
    "@types/node": "25.0.9",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "knip": "5.82.1",
    "lint-staged": "16.2.7",
    "postcss": "8.5.6",
    "prettier": "3.8.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "form-data@>=4.0.0 <4.0.4": ">=4.0.4",
      "axios@>=1.0.0 <1.12.0": ">=1.12.0",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "@modelcontextprotocol/sdk@<1.24.0": ">=1.24.0",
      "jws@<3.2.3": ">=3.2.3"
    }
  }
}
