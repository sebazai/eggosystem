# --- BUILD STAGE ---
FROM node:22-slim AS builder
RUN apt-get update && apt-get install -y default-mysql-client

# Enable PNPM using Corepack (built into Node.js 16+)
RUN corepack enable

WORKDIR /usr/src/app

# Copy workspace configuration and package manifests
COPY pnpm-workspace.yaml ./
COPY package.json pnpm-lock.yaml ./
COPY apps/backend/package.json apps/backend/
COPY packages/tsconfig/ ./packages/tsconfig/

# Install only necessary dependencies for `apps/backend`
RUN pnpm install --filter backend

# Copy Knex configuration and migration files
COPY apps/backend/knexfile.ts ./knexfile.ts
COPY apps/backend/migrations/ ./migrations/
COPY apps/backend/tsconfig.json ./tsconfig.json
COPY apps/backend/tsconfig.knex.json ./tsconfig.knex.json

# Compile knexfile.ts separately with tsconfig.knex.json
RUN npx tsc --project tsconfig.knex.json

# --- PRODUCTION STAGE ---
FROM node:22-slim AS production
RUN apt-get update && apt-get install -y default-mysql-client

ENV NODE_ENV=production
WORKDIR /usr/src/app

# Copy migration script
COPY scripts/wait-for-kanadb.sh ./scripts/wait-for-kanadb.sh
RUN chmod +x ./scripts/wait-for-kanadb.sh

# Copy compiled migrations, seeds, and Knex config from builder
COPY --from=builder /usr/src/app/dist/migrations/ ./migrations/
COPY --from=builder /usr/src/app/dist/knexfile.js ./knexfile.js

# Install only production dependencies
RUN pnpm install --prod --filter backend

# Run migrations on startup
CMD ["node", "node_modules/.bin/knex", "--knexfile=knexfile.js", "migrate:latest"]
  