{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for CS stats",
  "main": "dist/server.js",
  "scripts": {
    "test": "jest --coverage --runInBand",
    "build": "tsc -p tsconfig.prod.json",
    "start": "node ./dist/server.js",
    "dev": "NODE_ENV=development nodemon server.ts",
    "lint": "eslint .",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:down": "knex migrate:down",
    "migrate:up": "knex migrate:up",
    "seed": "knex seed:run",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "node.js",
    "express.api",
    "typescript"
  ],
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-async-errors": "3.1.1",
    "helmet": "8.0.0",
    "knex": "3.1.0",
    "morgan": "1.10.0",
    "mysql2": "3.12.0"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@eslint/js": "9.20.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.13.4",
    "@types/jest": "29.5.14",
    "@types/morgan": "1.9.9",
    "@types/mysql": "2.15.26",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.24.1",
    "@typescript-eslint/parser": "8.24.1",
    "eslint": "9.20.1",
    "eslint-plugin-jest": "28.11.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "nodemon": "3.1.9",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
