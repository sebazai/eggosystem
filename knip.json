{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["!**"],
      "project": ["!**"],
      "jest": false,
      "playwright": false,
      "next": false,
      "ignoreDependencies": [
        "@opentelemetry/auto-instrumentations-node",
        "@opentelemetry/api"
      ]
    },
    "apps/backend": {
      "entry": ["server.ts", "migrations/**/*.ts", "seeds/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@opentelemetry/auto-instrumentations-node",
        "@opentelemetry/otlp-exporter-base"
      ]
    },
    "apps/frontend": {
      "entry": ["src/app/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "jest.config.mjs"],
      "jest": true,
      "ignoreDependencies": [
        "jest-junit",
        "jsdom",
        "tailwindcss",
        "tailwindcss-animate",
        "jest-environment-jsdom"
      ]
    },
    "packages/eslint": {
      "entry": ["*.js"],
      "project": ["*.js"]
    },
    "packages/shared-msw": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/tsconfig": {
      "entry": ["!**"],
      "project": ["!**"]
    },
    "packages/types": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/viewer": {
      "entry": ["dev/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/src/components/ui/**",
    "**/.lintstagedrc.mjs",
    "**/apps/frontend/jest.config.js"
  ]
}
