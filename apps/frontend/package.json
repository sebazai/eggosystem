{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agents-md": "npx @next/codemod@canary agents-md --output AGENTS.md",
    "postinstall": "[ -f scripts/agents-md-if-needed.cjs ] && node scripts/agents-md-if-needed.cjs || true",
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "NEXT_PUBLIC_IMAGE_SERVICE_URL=https://img.kanaliiga.fi next build",
    "postbuild": "pnpm copy-standalone",
    "copy-standalone": "mkdir -p .next/standalone/apps/frontend/.next/static && cp -r .next/static/* .next/standalone/apps/frontend/.next/static/ && cp -r public .next/standalone/apps/frontend/public",
    "start:standalone": "PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/apps/frontend/server.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.mjs",
    "test:watch": "jest --config jest.config.mjs --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:container": "PLAYWRIGHT_BROWSERS_PATH=/ms-playwright playwright test",
    "playwright-trace": "playwright show-trace --host 0.0.0.0 --port 9323",
    "clean": "rm -rf cache .next"
  },
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "@eggosystem/viewer": "workspace:*",
    "@fullcalendar/core": "6.1.20",
    "@fullcalendar/daygrid": "6.1.20",
    "@fullcalendar/interaction": "6.1.20",
    "@fullcalendar/react": "6.1.20",
    "@fullcalendar/timegrid": "6.1.20",
    "@hookform/error-message": "2.0.1",
    "@hookform/resolvers": "5.2.2",
    "@tailwindcss/postcss": "4.3.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.2.1",
    "framer-motion": "12.39.0",
    "lodash": "4.18.1",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.0",
    "recharts": "3.8.0",
    "sonner": "2.0.7",
    "swr": "2.4.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.24",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "17.0.0",
    "jsdom": "29.1.1",
    "jsonwebtoken": "9.0.3",
    "postcss": "8.5.15",
    "shadcn": "4.7.0",
    "tailwindcss": "4.3.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "uuid": "11.1.0"
  }
}
