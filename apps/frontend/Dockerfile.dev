# Stage 1: Build Stage
FROM node:22-slim
ENV NODE_ENV=development
WORKDIR /usr/src/app
COPY . .
RUN npm install -g pnpm
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --filter=!backend --ignore-scripts --frozen-lockfile
# Expose the port
EXPOSE 3000
ENV PORT=3000

# Start Next.js server
CMD [ "pnpm", "--filter=frontend", "dev" ]
