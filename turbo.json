{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "env": [
        "NODE_ENV",
        "DB_ROOT_USER",
        "DB_ROOT_PASSWORD",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "PORT",
        "DB_HOST",
        "DB_PORT"
      ],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "add-shadcn-component": {
      "cache": false
    }
  }
}
