{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "test": "playwright test src/__tests__/integration/ --reporter=dot",
    "test:integration": "playwright test src/__tests__/integration/",
    "test:integration:profile": "pnpm --filter=\"@eggosystem/types\" build && playwright test src/__tests__/integration/profile-form.spec.ts",
    "test:integration:ui": "playwright test src/__tests__/integration/ --ui",
    "test:integration:headed": "playwright test src/__tests__/integration/ --headed",
    "test:e2e": "pnpm --filter=\"@eggosystem/types\" build && playwright test src/__tests__/e2e/",
    "test:e2e:ui": "playwright test src/__tests__/e2e/ --ui",
    "test:e2e:headed": "playwright test src/__tests__/e2e/ --headed",
    "test:e2e:profile": "pnpm --filter=\"@eggosystem/types\" build && playwright test src/__tests__/e2e/profile-form.spec.ts",
    "test:e2e:container": "PLAYWRIGHT_BROWSERS_PATH=/ms-playwright playwright test src/__tests__/e2e/ --browser=chromium"
  },
  "dependencies": {
    "@eggosystem/types": "workspace:*",
    "@hookform/error-message": "2.0.1",
    "@hookform/resolvers": "5.0.1",
    "@radix-ui/react-accordion": "1.2.4",
    "@radix-ui/react-checkbox": "1.1.5",
    "@radix-ui/react-dialog": "1.1.7",
    "@radix-ui/react-dropdown-menu": "2.1.7",
    "@radix-ui/react-label": "2.1.3",
    "@radix-ui/react-navigation-menu": "1.2.6",
    "@radix-ui/react-popover": "1.1.7",
    "@radix-ui/react-separator": "1.1.4",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-tabs": "1.1.4",
    "@radix-ui/react-tooltip": "1.2.0",
    "@tailwindcss/postcss": "4.1.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.9.4",
    "js-cookie": "3.0.5",
    "lodash": "4.17.21",
    "lucide-react": "0.488.0",
    "next": "15.3.1",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.56.2",
    "sonner": "2.0.3",
    "swr": "2.3.3",
    "tailwind-merge": "3.2.0",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@playwright/test": "1.52.0",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.16",
    "@types/node": "22.15.3",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "shadcn": "2.5.0",
    "tailwindcss": "4.1.5",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.3"
  }
}
