{
  "name": "eggosystem",
  "version": "0.0.1",
  "author": "Sebastian Sergelius",
  "license": "GPL-3.0",
  "description": "A unified monorepo for Kanahub’s frontend and backend services.",
  "scripts": {
    "shadcn:add": "turbo run add-shadcn-component -- --",
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint --continue",
    "lint:fix": "turbo lint --continue -- --fix",
    "clean": "turbo clean",
    "check-types": "turbo check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,mjs,js,jsx,json}\"",
    "prepare": "[ \"$NODE_ENV\" != \"production\" ] && husky || true",
    "migrate": "turbo migrate",
    "migrate:rollback": "turbo migrate:rollback",
    "migrate:down": "turbo migrate:down",
    "seed": "turbo seed"
  },
  "lint-staged": {
    "**/*.{json,md,yml,js,ts,tsx,jsx}": "pnpm format",
    "**/*.{js,ts,tsx,jsx}": "pnpm --filter=!frontend lint:fix",
    "**/apps/frontend/**/*.{js,ts,tsx,jsx}": "pnpm --filter=frontend lint:fix"
  },
  "keywords": [
    "kanahub",
    "eggosystem"
  ],
  "dependencies": {
    "turbo": "2.4.2"
  },
  "devDependencies": {
    "@eggosystem/eslint": "workspace:*",
    "@eggosystem/tsconfig": "workspace:*",
    "@types/node": "22.13.4",
    "eslint": "9.20.1",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "postcss": "8.5.3",
    "prettier": "3.5.1",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.3.0+sha512.ee592eda8815a8a293c206bb0917c4bb0ff274c50def7cbc17be05ec641fc2d1b02490ce660061356bd0d126a4d7eb2ec8830e6959fb8a447571c631d5a2442d"
}
